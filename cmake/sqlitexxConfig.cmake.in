# CMake package for sqlitexx @PROJECT_VERSION@: find_package(sqlitexx) gives the target sqlitexx::sqlitexx.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# This sqlitexx was built with:
#   SQLite:                   @sqlitexx_sqlite_summary@
#   expected:                 @sqlitexx_expected_summary@
#   string_view and optional: @sqlitexx_cxx17_summary@
set(sqlitexx_EXPECTED "@sqlitexx_expected@")
set(sqlitexx_CXX17_TYPES "@sqlitexx_cxx17_types@")

if(@sqlitexx_needs_threads@)
    find_dependency(Threads)
endif()

if(@SQLITEXX_USE_SYSTEM_SQLITE@)
    find_dependency(SQLite3 @SQLITEXX_SQLITE_MIN_VERSION@)
endif()

if(@sqlitexx_needs_expected_lite@)
    find_dependency(expected-lite CONFIG)
endif()

if(@sqlitexx_needs_lite_types@)
    find_dependency(string-view-lite CONFIG)
    find_dependency(optional-lite CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sqlitexxTargets.cmake")

check_required_components(sqlitexx)
